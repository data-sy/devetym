---
/**
 * **조회 전용 SSR 폴백** — `/term/<key>`가 정적 650장에 없을 때만 도달한다
 * (ADR-0013 Decision 2·3·4).
 *
 * ⚠️ **404 페이지가 이 일을 겸할 수 없다 — 실측(2026-09-02).** `404.astro`에서
 *    `Astro.response.status = 200`을 써도 **응답은 404로 고정된다**(본문은 정상 렌더됐다).
 *    즉 "내용은 맞는데 상태가 틀린" 페이지가 나가고, 크롤러·공유 미리보기·모니터링은 전부
 *    없는 페이지로 읽는다. 그래서 폴백을 **자기 라우트**로 분리했다. 여기서는 200이 기본이고
 *    없을 때만 404를 세운다 — 상태와 내용이 같은 방향을 본다.
 *
 * ⚠️ **생성을 트리거하지 않는다.** GET 경로에 생성을 두면 크롤러 한 번이 웹 전역 캡 30건을
 *    태운다(T6). ADR-0013 기각안 3 — 구현 중 되돌아오기 쉬운 지점이라 ADR에 박아 뒀다.
 *
 * ⚠️ **`noindex`다.** 색인 자격은 품질 게이트(승격 잡 W1c)가 연다(Decision 4).
 *    승격되면 `origin='authored'`가 되어 **다음 빌드에서 SSG 집합에 편입**되고, 그때
 *    이 라우트를 더 이상 타지 않으면서 색인된다.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import TermArticle from "../../components/TermArticle.astro";
import NotFound from "../../components/NotFound.astro";
import { lookupTerm } from "../../lib/lookup";
import { normalizeTermKey } from "../../lib/term-key";

export const prerender = false;

const { rest } = Astro.params;
// `/term/a/b` 같은 다중 세그먼트는 용어가 아니다 — 없는 페이지로 접는다.
const requestedKey =
  typeof rest === "string" && rest && !rest.includes("/")
    ? normalizeTermKey(decodeURIComponent(rest))
    : "";

const db = (Astro.locals as any)?.runtime?.env?.CACHE_DB;
const term = requestedKey ? await lookupTerm(db, requestedKey) : null;

if (term) {
  // 미승격 생성분이라 오래 캐시하지 않는다 — 승격되면 다음 빌드에서 정적 200으로 바뀐다.
  Astro.response.headers.set("cache-control", "public, max-age=60, stale-while-revalidate=600");
} else {
  Astro.response.status = 404;
  Astro.response.headers.set("cache-control", "public, max-age=300");
}

const HANGUL = /[가-힣]/;
const koreanAlias = term
  ? (term.aliases.filter((a) => HANGUL.test(a)).sort((a, b) => a.length - b.length)[0] ?? null)
  : null;
const headword = term ? (koreanAlias ? `${koreanAlias}(${term.keyword})` : term.keyword) : "";
---
{
  term ? (
    <BaseLayout
      title={`${headword} — 왜 이렇게 부르는가`}
      description={term.summary}
      path={`/term/${requestedKey}`}
      noindex
    >
      <main>
        <TermArticle term={term} koreanAlias={koreanAlias} path={`/term/${requestedKey}`} generated={term.generated}>
          <p class="ask"><a href="/search">다른 용어 검색하기</a></p>
        </TermArticle>
      </main>
    </BaseLayout>
  ) : (
    <BaseLayout title="찾는 용어가 없어요" path={Astro.url.pathname} noindex>
      <NotFound requestedKey={requestedKey} />
    </BaseLayout>
  )
}

<style>
  .ask { margin: var(--d-section-gap) 0 0; font-size: var(--t-label-size); }
</style>
